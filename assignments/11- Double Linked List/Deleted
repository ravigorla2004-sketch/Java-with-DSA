class Node {
    int data;
    Node prev;
    Node next;

    Node(int data) {
        this.data = data;
    }
}

public class Main {
    Node head;

    // Insert at end
    void insert(int data) {
        Node newNode = new Node(data);

        if (head == null) {
            head = newNode;
            return;
        }

        Node temp = head;

        while (temp.next != null) {
            temp = temp.next;
        }

        temp.next = newNode;
        newNode.prev = temp;
    }

    // Delete a node by value
    void delete(int data) {
        Node temp = head;

        // Find the node
        while (temp != null && temp.data != data) {
            temp = temp.next;
        }

        // Node not found
        if (temp == null) {
            return;
        }

        // If deleting the first node
        if (temp.prev == null) {
            head = temp.next;
        } else {
            temp.prev.next = temp.next;
        }

        // Update previous pointer
        if (temp.next != null) {
            temp.next.prev = temp.prev;
        }
    }

    // Display forward
    void display() {
        Node temp = head;

        while (temp != null) {
            System.out.print(temp.data + " ");
            temp = temp.next;
        }
    }

    public static void main(String[] args) {
        Main list = new Main();

        list.insert(10);
        list.insert(20);
        list.insert(30);
        list.insert(40);

        System.out.println("Before deletion:");
        list.display();

        list.delete(30);

        System.out.println("\nAfter deleting 30:");
        list.display();
    }
}

output:
Before deletion:
10 20 30 40 
After deleting 30:
10 20 40 
